# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/
.env

# Firebase - inherently public Android API key but no reason to keep
# committing it; same treatment as bhav-bhakti-be's firebase-service-account.json.
# Present on disk locally, referenced by app.json's android.googleServicesFile,
# and consumed by the @react-native-firebase/app config plugin at prebuild
# time - stays fully usable for local/CI builds without being tracked.
google-services.json
# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
